{
  "name": "pstack-dsh",
  "description": "DeepSeek Harness port of official pstack. Playbooks and principles are poteto's; only the harness call layer is rewritten.",
  "version": "0.2.5",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "src",
    "skills",
    "agents",
    "presets",
    "cordis.patch.yml",
    "HARNESS.md",
    "README.md",
    "TEST-PLAN.md",
    "LICENSE",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "\"$DSH_SOURCE/node_modules/.bin/tsdown\" --config-loader native",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "node --experimental-strip-types --test tests/*.spec.ts",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": "^22.19.0 || >=24",
    "dsh": ">=0.2.2-rc.1 <0.2.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aa2246740/pstack-dsh.git"
  },
  "homepage": "https://github.com/aa2246740/pstack-dsh",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "pstack",
    "poteto-mode"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-atomic-write": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-client-connection": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-client-locale": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-credentials": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-settings": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-skill": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-skill-filesystem": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-subagent": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-util-values": ">=0.2.2-rc.1 <0.2.3",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-atomic-write": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-atomic-write": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-client-connection": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-client-locale": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-credentials": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-settings": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-skill": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-skill-filesystem": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-subagent": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1 <0.2.3",
    "@deepseek-ai/dsh-util-values": ">=0.2.2-rc.1 <0.2.3",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/semver": "^7.7.0",
    "react": "^18.2.0",
    "semver": "^7.7.2",
    "typescript": "^6.0.3"
  }
}
